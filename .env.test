NODE_ENV=development
PORT=3001

# PostgreSQL — must match POSTGRES_PASSWORD in docker-compose.yml
DATABASE_URL=postgresql://elicense:devpassword@localhost:5432/elicense?schema=public
DB_PASSWORD=devpassword

# JWT RS256 keys — leave blank in development; keys are auto-generated at startup.
# In production set these to base64-encoded PEM strings.
JWT_PRIVATE_KEY_
JWT_PUBLIC_KEY_
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=7

# CORS origins for the two frontends
APP_ORIGIN=http://localhost:3003
ADMIN_ORIGIN=http://localhost:3002

# DGA Digital ID / ทางรัฐ OIDC 1.0 (local test only; do not commit)
DGA_OIDC_ENV=uat
DGA_OIDC_MODE=real
DGA_OIDC_BASE_URL=https://connect.dga.or.th
DGA_OIDC_CLIENT_ID=4a72fe1a-7a07-4542-9960-3cda754845ee
DGA_OIDC_CLIENT_SECRET=OGdw7W2t73b
DGA_OIDC_REDIRECT_URI=https://e-license.govcenter.co/auth/login-callback
DGA_OIDC_ALLOWED_REDIRECT_URIS=https://e-license.govcenter.co/auth/login-callback
DGA_OIDC_LOGOUT_REDIRECT_URI=https://e-license.govcenter.co/auth/logout-callback
DGA_OIDC_SCOPE=openid citizen_id given_name family_name
DGA_OIDC_STATE_SECRET=

# MinIO — endpoint uses the Docker service name when running inside compose
MINIO_ENDPOINT=http://localhost:9000
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=elicense
MINIO_SECRET_KEY=devpassword
MINIO_BUCKET=elicense-private
