NODE_ENV=development
PORT=3001

# PostgreSQL — must match POSTGRES_PASSWORD in docker-compose.yml
DATABASE_URL=postgresql://elicense:devpassword@db:5432/elicense?schema=public
DB_PASSWORD=devpassword

# JWT RS256 keys — leave blank in development; keys are auto-generated at startup.
# In production set these to base64-encoded PEM strings.
JWT_PRIVATE_KEY_BASE64=
JWT_PUBLIC_KEY_BASE64=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=7

# CORS origins for the two frontends
APP_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:3002

# MinIO — endpoint uses the Docker service name when running inside compose
MINIO_ENDPOINT=http://minio:9000
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=elicense
MINIO_SECRET_KEY=devpassword
MINIO_BUCKET=elicense-private
