NODE_ENV=development
PORT=3001

# PostgreSQL — must match POSTGRES_PASSWORD in docker-compose.yml
DATABASE_URL=postgresql://elicense:devpassword@db:5432/elicense?schema=public
DB_PASSWORD=devpassword

# JWT RS256 keys — leave blank in development; keys are auto-generated at startup.
# In production set these to base64-encoded PEM strings.
JWT_PRIVATE_KEY_BASE64=
JWT_PUBLIC_KEY_BASE64=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=7

# CORS origins for the two frontends
APP_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:3002

# DGA Digital ID / ทางรัฐ OIDC 1.0
# UAT base URL: https://connect.dga.or.th
# Production base URL: https://connect.egov.go.th
DGA_OIDC_ENV=uat
# Use `mock` for local prototype, `real` for DGA UAT/Production.
DGA_OIDC_MODE=mock
DGA_OIDC_BASE_URL=https://connect.dga.or.th
DGA_OIDC_CLIENT_ID=
DGA_OIDC_CLIENT_SECRET=
DGA_OIDC_REDIRECT_URI=http://localhost:3000/auth/dga/callback
DGA_OIDC_ALLOWED_REDIRECT_URIS=http://localhost:3000/auth/dga/callback
DGA_OIDC_LOGOUT_REDIRECT_URI=http://localhost:3000/auth/logout-callback
DGA_OIDC_SCOPE=openid citizen_id given_name family_name
# Random 32+ byte secret for signing stateless OIDC state. Leave blank in dev to derive from JWT key.
DGA_OIDC_STATE_SECRET=
# Random 32+ byte secret for encrypting provider id_token at rest. Leave blank in dev to derive from state/JWT key.
DGA_OIDC_ID_TOKEN_ENCRYPTION_KEY=

# DGA ทางรัฐ mToken landing flow. This is independent from OIDC so deployments
# can select either protocol without removing the other endpoints.
# Set DGA_MTOKEN_MODE=real only after DGA has registered the landing URL/app ID.
DGA_MTOKEN_MODE=mock
DGA_MTOKEN_ENV=uat
DGA_MTOKEN_CONSUMER_KEY=
DGA_MTOKEN_CONSUMER_SECRET=
DGA_MTOKEN_APP_ID=
DGA_MTOKEN_SESSION_HOURS=12
# Revoke a user's earlier mToken app session when Tang Rat launches a new one.
DGA_MTOKEN_SINGLE_SESSION=true
# Override only when DGA provides environment-specific API URLs.
# DGA_MTOKEN_VALIDATE_URL=https://api.egov.go.th/ws/auth/validate
# DGA_MTOKEN_DEPROC_URL=https://api.egov.go.th/ws/dga/czp/uat/v1/core/shield/data/deproc

# MinIO — endpoint uses the Docker service name when running inside compose
MINIO_ENDPOINT=http://minio:9000
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=elicense
MINIO_SECRET_KEY=devpassword
MINIO_BUCKET=elicense-private

# CITIZEN_ID_PEPPER is no longer used (owner decision: store citizen ID as plaintext
# in citizen_id_hash column for searchability + gov integration; security via TDE + RBAC + audit).
# The variable can be removed or left commented for future use.
# CITIZEN_ID_PEPPER=...
