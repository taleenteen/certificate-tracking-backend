# Use this when running the API directly on your Mac (not inside Docker).
# cp .env.local.example .env.local
NODE_ENV=development
PORT=3001

# Localhost — because the API runs on your Mac, not inside Docker
DATABASE_URL=postgresql://elicense:devpassword@localhost:5432/elicense?schema=public
DB_PASSWORD=devpassword

# JWT keys — left blank means auto-generated ephemeral keys (fine for dev)
JWT_PRIVATE_KEY_BASE64=
JWT_PUBLIC_KEY_BASE64=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=7

APP_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:3002

# Localhost — MinIO also runs on your Mac via Docker port binding
MINIO_ENDPOINT=http://localhost:9000
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=elicense
MINIO_SECRET_KEY=devpassword
MINIO_BUCKET=elicense-private
