# =================================================================
# E-License Production Environment
# Copy this file to .env.deploy and fill in real values.
# Never commit .env.deploy to git.
# =================================================================

# Public hostname or IP of your Ubuntu server (no http://, no trailing slash)
SERVER_HOST=your-server-ip

# ── Database ──────────────────────────────────────────────────────
DB_PASSWORD=change-this-strong-db-password

# ── MinIO (file storage) ──────────────────────────────────────────
MINIO_ACCESS_KEY=elicense
MINIO_SECRET_KEY=change-this-strong-minio-password

# ── JWT RS256 Keys ────────────────────────────────────────────────
# Generate on the server with:
#
#   openssl genrsa -out jwt_private.pem 2048
#   openssl rsa -in jwt_private.pem -pubout -out jwt_public.pem
#   export JWT_PRIVATE_KEY_BASE64=$(base64 -w0 jwt_private.pem)
#   export JWT_PUBLIC_KEY_BASE64=$(base64 -w0 jwt_public.pem)
#   echo "JWT_PRIVATE_KEY_BASE64=$JWT_PRIVATE_KEY_BASE64"
#   echo "JWT_PUBLIC_KEY_BASE64=$JWT_PUBLIC_KEY_BASE64"
#
# Then paste the output below and delete the .pem files.
JWT_PRIVATE_KEY_BASE64=
JWT_PUBLIC_KEY_BASE64=

# ── Mapbox (optional — for map features) ─────────────────────────
NEXT_PUBLIC_MAPBOX_TOKEN=
