# Production deploy env template for docker-compose.production.yml
#
# On the server:
#   cp .env.app.example .env.app
#   nano .env.app
#   docker compose --env-file .env.app -f docker-compose.production.yml up -d --build

PUBLIC_HOST=e-license.govcenter.co
FRONTEND_PUBLIC_PORT=3015

NODE_ENV=production
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=7

POSTGRES_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD

# Generate on the server:
#   openssl genrsa -out jwt_private.pem 2048
#   openssl rsa -in jwt_private.pem -pubout -out jwt_public.pem
#   base64 -w0 jwt_private.pem
#   base64 -w0 jwt_public.pem
JWT_PRIVATE_KEY_BASE64=CHANGE_ME_BASE64_PRIVATE_PEM
JWT_PUBLIC_KEY_BASE64=CHANGE_ME_BASE64_PUBLIC_PEM

# DGA Digital ID / ทางรัฐ OIDC
DGA_OIDC_ENV=production
DGA_OIDC_BASE_URL=https://connect.egov.go.th
DGA_OIDC_CLIENT_ID=CHANGE_ME_DGA_CONSUMER_KEY
DGA_OIDC_CLIENT_SECRET=CHANGE_ME_DGA_CONSUMER_SECRET

# Generate random secrets on the server:
#   openssl rand -base64 48
DGA_OIDC_STATE_SECRET=CHANGE_ME_RANDOM_32_PLUS_BYTES_STATE_SECRET
DGA_OIDC_ID_TOKEN_ENCRYPTION_KEY=CHANGE_ME_RANDOM_32_PLUS_BYTES_ID_TOKEN_SECRET

MINIO_ROOT_USER=elicense
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG_MINIO_PASSWORD
MINIO_REGION=us-east-1
MINIO_BUCKET=elicense-private

NEXT_PUBLIC_MAPBOX_TOKEN=CHANGE_ME_MAPBOX_PUBLIC_TOKEN
